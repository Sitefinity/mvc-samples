@model PARAGAnswerWidget.Mvc.Models.AnswerViewModel
@using Telerik.Sitefinity.Services
@using PARAGCore

@if (SystemManager.IsDesignMode && !SystemManager.IsPreviewMode)
{
    <h1>This is default backend view. To be replaced by Niki</h1>
}
else
{
    <link href="@HtmlHelpers.GetCdnUrl("sf-assistant-chat-widget.css")" rel="stylesheet" type="text/css">
    <script src="@HtmlHelpers.GetCdnUrl("jquery.min.js")" type="text/javascript"></script>
    <script src="@HtmlHelpers.GetCdnUrl("marked.min.js")" type="text/javascript"></script>
    <script src="@HtmlHelpers.GetCdnUrl("sf-assistant-chat.js")" type="text/javascript"></script>
    <script src="@HtmlHelpers.GetCdnUrl("parag-chat-service.js")" type="text/javascript"></script>
    <script src="@HtmlHelpers.GetCdnUrl("sf-assistant-widget.js")" type="text/javascript" defer></script>

    <div id="paragAnswerBox"
         class="@Model.CssClass">
    </div>

    <script type="application/json" class="sf-assistant-widget-data">
        {
            "id": "sf-answer-box",
            "display": {
                "mode": "answer",
                "containerId": "paragAnswerBox"
            },
            "chat": {
                "bot": {
                    "name": "@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.Title))",
                    "avatarUrl": "@Html.Raw(HttpUtility.JavaScriptStringEncode((string.IsNullOrEmpty(Model.AssistantAvatarUrl) ? HtmlHelpers.GetCdnUrl("chat-avatar.svg") : Model.AssistantAvatarUrl)))"
                },
                "labels": {
                    "feedbackPromptText": "@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.Notice))",
                    "searchedPhraseLabel": "@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.SearchedPhraseLabel))",
                    "feedbackYesTooltipText": "@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.PositiveFeedbackTooltip))",
                    "feedbackNoTooltipText": "@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.NegativeFeedbackTooltip))",
                    "feedbackThanks": "@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.ThankYouMessage))",
                    "showMoreLabel": "@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.ExpandAnswerLabel))",
                    "showLessLabel": "@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.CollapseAnswerLabel))",
                    "loadingLabel": "@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.LoadingLabel))"
                }
            },
            "serviceSettings": {
                "serviceType": "ProgressARAGChatService",
                "endpoint": "@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.ServiceUrl))",
                "knowledgeBoxName": "@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.KnowledgeBoxName))",
                "configurationName": "@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.ConfigName))",
                "showSources": "@Html.Raw(Model.ShowSources)",
                "showFeedbackButtons": "@Html.Raw(Model.ShowFeedback)",
                "initialPrompt": "@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.SearchQuery))"
            }
        }
    </script>
}

